# Copy this file to .env for local emulator use (never commit the real .env).
# The assistant uses local intent rules and response templates; no AI API key is needed.
# Non-secret configuration can stay in .env for emulator use.
# Optional override: exact bucket name from Firebase Console if FIREBASE_CONFIG has none.
# FIREBASE_STORAGE_BUCKET=

# --- App behavior --------------------------------------------------------
APP_ENV=development
DEFAULT_USER_ROLE=student
ALLOWED_ORIGINS=http://localhost:3000

# --- Rate limiting ---------------------------------------------------------
CHAT_RATE_LIMIT_PER_MINUTE=20
CONSULTATION_RATE_LIMIT_PER_DAY=5
