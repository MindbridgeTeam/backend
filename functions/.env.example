# Copy this file to .env for local emulator use (never commit the real .env).
# In production these are set as Cloud Functions secrets, NOT as plain env vars:
#   firebase functions:secrets:set AI_API_KEY
#   firebase functions:secrets:set FCM_SERVER_KEY (if using legacy server key flows)
#
# Non-secret configuration can stay in .env / functions.config() style values.

# --- AI provider -------------------------------------------------------
AI_API_KEY=replace-me
AI_API_BASE_URL=https://api.anthropic.com
AI_MODEL=claude-sonnet-4-6

# --- App behavior --------------------------------------------------------
APP_ENV=development
DEFAULT_USER_ROLE=student
ALLOWED_ORIGINS=http://localhost:3000

# --- Rate limiting ---------------------------------------------------------
CHAT_RATE_LIMIT_PER_MINUTE=20
CONSULTATION_RATE_LIMIT_PER_DAY=5
